  "narrative": {
    "northStar": "The Quiet Operations Room",
    "overview": "DingoDocs feels like a well-run assessment room in daylight: focused, calm, and immediately legible. Cool tinted neutrals support long working sessions; Harbour Blue marks action, focus, and selection without washing the interface in brand colour.",
    "keyCharacteristics": [
      "Calm, precise, and operational",
      "Dense where comparison matters, spacious where decisions matter",
      "Keyboard-first and WCAG 2.2 AA",
      "Responsive from mobile to wide desktop",
      "Familiar controls with visible security and workflow state"
    ],
    "rules": [
      {
        "name": "The Ten Percent Rule",
        "body": "Harbour Blue occupies no more than ten percent of a typical working screen. Its rarity preserves meaning.",
        "section": "colors"
      },
      {
        "name": "The Redundancy Rule",
        "body": "Severity and workflow state always use text or iconography as well as colour.",
        "section": "colors"
      },
      {
        "name": "The Lift-on-Demand Rule",
        "body": "Resting content has no decorative shadow. A surface lifts only when it temporarily overlaps another surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reserve Harbour Blue 600 for meaningful action, active selection, and focus.",
      "Do maintain a three-pixel visible focus outline and complete keyboard paths."
    ],
    "donts": [
      "Don't use legacy enterprise layouts or generic admin-template styling.",
      "Don't use neon-on-black palettes, terminal decoration, glowing threat maps, or fear-driven copy.",
      "Don't communicate severity, status, or validation through colour alone."
    ]
