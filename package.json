{
  "name": "dingodocs",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:runtime": "esbuild scripts/run-migrations.ts --bundle --platform=node --format=cjs --target=node26 --tsconfig=tsconfig.json --inject:./scripts/esbuild-import-meta-url.js --define:import.meta.url=import_meta_url --outfile=dist/migrate.cjs && esbuild scripts/enforce-marketplace-license.ts --bundle --platform=node --format=cjs --target=node26 --tsconfig=tsconfig.json --inject:./scripts/esbuild-import-meta-url.js --define:import.meta.url=import_meta_url --outfile=dist/enforce-marketplace-license.cjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:lightpanda": "node scripts/run-lightpanda-tests.mjs",
    "mcp": "tsx src/mcp/server.ts",
    "dingodocs": "node scripts/dingodocs.mjs",
    "screenshot": "tsx scripts/capture-readme-screenshot.ts",
    "screenshots": "tsx scripts/capture-readme-screenshots.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seeds/index.ts",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-license-manager": "^3.1138.0",
