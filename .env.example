NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://dingodocs:dingodocs@localhost:5432/dingodocs
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
# Optional server-only identity providers (enable only when every required value is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
OIDC_PROVIDER_ID=oidc
OIDC_PROVIDER_LABEL=Single sign-on
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_SCOPES=openid profile email
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage/data
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dingodocs
S3_ACCESS_KEY_ID=dingodocs
S3_SECRET_ACCESS_KEY=dingodocs-local-only
# Path-style S3 addressing; only the exact string "true" enables it (always on for minio).
# S3_FORCE_PATH_STYLE=true
# AWS region for SES (fallback when SES_REGION is unset) and Marketplace license checks.
# AWS_REGION=ap-southeast-2
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=DingoDocs <noreply@localhost>
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_PROVIDER=smtp
EMAIL_FROM=DingoDocs <noreply@localhost>
# Optional for native Amazon SES delivery; task/pod role credentials are used.
SES_REGION=
CRON_TIMEZONE=Australia/Sydney
MAX_UPLOAD_BYTES=104857600
# Optional aggregate cap per evidence upload request; defaults to MAX_UPLOAD_BYTES + 1 MiB.
# MAX_UPLOAD_REQUEST_BYTES=
AI_ENABLED=false
# Operator-trusted Ollama origin; the only HTTP/private Ollama URL tenants may use in production.
# OLLAMA_BASE_URL=http://ollama:11434
INTEGRATION_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional malware scanner: evidence bytes are POSTed here; unset marks scans "unavailable".
# MALWARE_SCAN_URL=http://clamav-rest:8080/scan
# Optional LanguageTool server for finding write-up grammar checks.
# LANGUAGE_TOOL_URL=http://languagetool:8010
# Optional SIEM sink: audit events are POSTed here (public HTTPS only, best effort).
# SIEM_WEBHOOK_URL=https://siem.example.com/ingest
# Comma-separated user ids granted Better Auth platform-admin rights.
# BETTER_AUTH_ADMIN_USER_IDS=
