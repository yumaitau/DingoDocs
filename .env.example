NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://dingodocs:dingodocs@localhost:5432/dingodocs
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
# Optional server-only identity providers (enable only when every required value is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
OIDC_PROVIDER_ID=oidc
OIDC_PROVIDER_LABEL=Single sign-on
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_SCOPES=openid profile email
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage/data
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dingodocs
S3_ACCESS_KEY_ID=dingodocs
S3_SECRET_ACCESS_KEY=dingodocs-local-only
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=DingoDocs <noreply@localhost>
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CRON_TIMEZONE=Australia/Sydney
MAX_UPLOAD_BYTES=104857600
AI_ENABLED=false
INTEGRATION_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
OTEL_EXPORTER_OTLP_ENDPOINT=
